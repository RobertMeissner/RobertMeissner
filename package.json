{
  "name": "robertmeissner-pages",
  "private": true,
  "description": "Build tooling for the static games under docs/src (served from docs/js)",
  "scripts": {
    "build:games": "esbuild docs/src/tessera.ts docs/src/pyramids.ts docs/src/laststand.ts docs/src/siege.ts --bundle --format=iife --target=es2020 --outdir=docs/js",
    "typecheck": "tsc --noEmit"
  },
